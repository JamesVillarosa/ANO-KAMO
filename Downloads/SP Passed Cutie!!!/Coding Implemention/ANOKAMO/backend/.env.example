# Database Configuration
DATABASE_URL=sqlite:///./app.db

# FastAPI Configuration
DEBUG=False
LOG_LEVEL=INFO

# CORS Origins (comma-separated or JSON array)
# For local development with Expo, allow:
# - http://localhost:3000 (web dev)
# - http://localhost:19000 (Expo dev server)
# - http://10.0.2.2:8000 (Android emulator localhost)
CORS_ORIGINS=["http://localhost:3000","http://localhost:19000","http://10.0.2.2:8000"]

# External API Keys (Placeholder - replace with real keys)
# Visit https://ai.google.dev to get a free Gemini API key
GEMINI_API_KEY=sk-placeholder-gemini-key

# Whisper API key (for STT/TTS)
WHISPER_API_KEY=sk-placeholder-whisper-key

# App Configuration
APP_NAME=Ano-Kamo Backend
VERSION=0.1.0
