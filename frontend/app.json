{
  "expo": {
    "name": "Ano-Kamo?",
    "slug": "ano-kamo",
    "scheme": "ano-kamo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEF2F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.villarosa.jamescarl.anokamo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEF2F6"
      },
      "package": "com.villarosa.jamescarl.anokamo",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ano-Kamo to access your camera for text recognition."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec33d8bf-fe99-436d-b88d-23019e426d3e"
      }
    }
  }
}
